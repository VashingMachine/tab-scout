{
  "manifest_version": 3,
  "name": "Tab Scout",
  "version": "1.0",
  "description": "Lets the Tab Scout app on this Mac group a window's tabs by topic when you ask it to.",
  "key": "",
  "minimum_chrome_version": "105",
  "permissions": ["tabs", "tabGroups", "nativeMessaging", "alarms"],
  "background": {"service_worker": "background.js"}
}
