{
  "manifest_version": 2,
  "name": "Tab Scout",
  "version": "1.2",
  "description": "Lets the Tab Scout app on this Mac search, switch to, open and close this browser's tabs when you press Cmd+T, and sort them into folders.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tabscout@local.tabscout",
      "strict_min_version": "140.0",
      "data_collection_permissions": {"required": ["browsingActivity"]}
    }
  },
  "permissions": ["tabs", "nativeMessaging", "search", "storage", "cookies"],
  "background": {"scripts": ["background.js"]},
  "experiment_apis": {
    "tabScoutFolders": {
      "schema": "folders.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["tabScoutFolders"]],
        "script": "folders.js"
      }
    }
  }
}
