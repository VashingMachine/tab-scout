{
  "manifest_version": 3,
  "name": "Tab Scout",
  "version": "1.4.0",
  "description": "Find an open Safari tab before opening another one.",
  "permissions": ["tabs", "storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "commands": {
    "toggle-search": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Search Safari tabs"
    }
  },
  "web_accessible_resources": [{
    "resources": ["overlay-frame.html"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "action": {
    "default_title": "Search Safari tabs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/app-16.png",
      "32": "icons/app-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/app-16.png",
    "32": "icons/app-32.png",
    "48": "icons/app-48.png",
    "128": "icons/app-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https:; img-src 'self' data:; style-src 'self'"
  }
}
